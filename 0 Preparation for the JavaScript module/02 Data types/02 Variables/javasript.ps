// Variable with number type
const number = 10;
console.log(number);
console.log(typeof number);
// This variable's type is number, and it stores the value 10


// Variable with string type
const string = "Hello";
console.log(string);
console.log(typeof string);
// This variable's type is string, and it stores the value "Hello"


// Variable with number + string type
const numberPlusString = 2 + "two";
console.log(numberPlusString);
console.log(typeof numberPlusString);
// This variable's type is string, and it stores the value "2two"


// Variable with boolean type
const boolean = true;
console.log(boolean);
console.log(typeof boolean);
// This variable's type is boolean, and it stores the value true


// Variable with special value
const specialValue = null;
console.log(specialValue);
console.log(typeof specialValue);
// This variable's type is object (special case in JavaScript), and it stores the value null


// Variable with undefined type
let undefinedValue;
console.log(undefinedValue);
console.log(typeof undefinedValue);
// This variable's type is undefined, and it stores the value undefined